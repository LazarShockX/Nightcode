        "postinstall": "bun run --cwd ../database db:generate"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.49",
        "@ai-sdk/openai": "^4.0.58",
        "@ai-sdk/provider-utils": "^5.0.36",
        "@clerk/backend": "^3.17.2",
        "@hono/zod-validator": "^0.9.1",
        "@nightcode/database": "workspace:*",
        "@nightcode/shared": "workspace:*",
        "@sentry/bun": "^10.73.0",
        "@sentry/hono": "^10.73.0",
        "ai": "^7.0.92",
        "dotenv": "^17.4.2",
        "hono": "^4.13.5",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@types/bun": "latest"
    }
